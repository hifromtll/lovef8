'use client';

import { useEffect, useMemo, useState } from 'react';
import { snippet } from '../utils';
import type {
  ChatMode,
  Conversation,
  HostRow,
  LastMsg,
  ProfileMini,
  ProfilePreviewData,
  UserRow,
} from '../types';

type SidebarProps = {
  userId: string | null;
  activeConversationId: string | null;
  hosts: HostRow[];
  hostsLoading: boolean;
  hostsError: string | null;
  users: UserRow[];
  usersLoading: boolean;
  usersError: string | null;
  blocksLoading: boolean;
  isApprovedHostMe: boolean;
  inboxConversations: Conversation[];
  hiddenConversations?: Conversation[];
  labels: Record<string, ProfileMini>;
  lastByConvo: Record<string, LastMsg>;
  unreadByConvo: Record<string, boolean>;
  onlineProfileIds?: Set<string>;
  isDesktop: boolean;
  showHostsSection: boolean;
  showUsersSection: boolean;
  viewerTimezone?: string | null;
  onRefreshHosts: () => void | Promise<void>;
  onRefreshUsers: () => void | Promise<void>;
  onRefreshInbox: () => void | Promise<void>;
  onOpenProfile: (profileId: string) => void | Promise<void>;
  onOpenProfilePreview: (profile: ProfilePreviewData) => void;
  onSelectConversation: (conversationId: string) => void;
  onHideConversation: (conversationId: string) => void | Promise<void>;
  onRestoreConversation: (conversationId: string) => void | Promise<void>;
};

function formatSidebarTime(value: string) {
  const d = new Date(value);
  const now = new Date();

  const sameDay =
    d.getFullYear() === now.getFullYear() &&
    d.getMonth() === now.getMonth() &&
    d.getDate() === now.getDate();

  if (sameDay) {
    return d.toLocaleTimeString([], {
      hour: 'numeric',
      minute: '2-digit',
    });
  }

  return d.toLocaleDateString([], {
    month: 'short',
    day: 'numeric',
  });
}

function getDisplayName(profile: ProfileMini | undefined) {
  return profile?.username?.trim()
    ? profile.username
    : profile?.is_system_host
      ? 'LoveF8 Guide'
      : profile?.role === 'host'
        ? 'Host'
        : 'User';
}

function getModeLabel(mode: ChatMode | string | null | undefined) {
  switch (mode) {
    case 'chatty':
      return 'Chatty';
    case 'flirty':
      return 'Flirty';
    case 'romantic':
      return 'Romantic';
    case 'open_all':
      return 'Open to all';
    default:
      return null;
  }
}

function getModeClasses(mode: ChatMode | string | null | undefined) {
  switch (mode) {
    case 'chatty':
      return 'bg-sky-100 text-sky-800';
    case 'flirty':
      return 'bg-pink-100 text-pink-800';
    case 'romantic':
      return 'bg-rose-100 text-rose-800';
    case 'open_all':
      return 'bg-violet-100 text-violet-800';
    default:
      return 'bg-neutral-100 text-neutral-600';
  }
}

function normalizeTags(tags: string[] | null | undefined): string[] {
  const raw = (tags || []).filter(Boolean).map((tag) => tag.trim()).filter(Boolean);

  const splitTags: string[] = [];
  for (const tag of raw) {
    if (tag.includes(',')) {
      splitTags.push(
        ...tag
          .split(',')
          .map((part) => part.trim())
          .filter(Boolean)
      );
    } else {
      splitTags.push(tag);
    }
  }

  return splitTags.slice(0, 3);
}

function parseTimeParts(value: string | null | undefined) {
  if (!value) return null;

  const normalized = value.slice(0, 5);
  const [hourText, minuteText] = normalized.split(':');

  const hour = Number(hourText);
  const minute = Number(minuteText);

  if (Number.isNaN(hour) || Number.isNaN(minute)) return null;
  if (hour < 0 || hour > 23 || minute < 0 || minute > 59) return null;

  return { hour, minute };
}

function formatOnlineWindowForViewer(
  start: string | null | undefined,
  end: string | null | undefined,
  sourceTimezone: string | null | undefined,
  viewerTimezone: string | null | undefined
) {
  if (!start || !end || !sourceTimezone || !viewerTimezone) return null;

  const startParts = parseTimeParts(start);
  const endParts = parseTimeParts(end);

  if (!startParts || !endParts) return null;

  try {
    const anchor = new Date('2024-01-01T00:00:00Z');

    const sourceDateText = new Intl.DateTimeFormat('en-CA', {
      timeZone: sourceTimezone,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).format(anchor);

    const [yearText, monthText, dayText] = sourceDateText.split('-');
    const year = Number(yearText);
    const month = Number(monthText);
    const day = Number(dayText);

    const makeUtcFromSourceLocal = (hour: number, minute: number) => {
      const utcGuess = new Date(Date.UTC(year, month - 1, day, hour, minute, 0));

      const asSource = new Date(utcGuess.toLocaleString('en-US', { timeZone: sourceTimezone }));

      const offsetMs =
        Date.UTC(
          asSource.getFullYear(),
          asSource.getMonth(),
          asSource.getDate(),
          asSource.getHours(),
          asSource.getMinutes(),
          asSource.getSeconds()
        ) - utcGuess.getTime();

      return new Date(utcGuess.getTime() - offsetMs);
    };

    const startUtc = makeUtcFromSourceLocal(startParts.hour, startParts.minute);
    const endUtc = makeUtcFromSourceLocal(endParts.hour, endParts.minute);

    const startLabel = new Intl.DateTimeFormat('en-US', {
      timeZone: viewerTimezone,
      hour: 'numeric',
      minute: '2-digit',
    }).format(startUtc);

    const endLabel = new Intl.DateTimeFormat('en-US', {
      timeZone: viewerTimezone,
      hour: 'numeric',
      minute: '2-digit',
    }).format(endUtc);

    if (viewerTimezone === sourceTimezone) {
      return `${startLabel}–${endLabel}`;
    }

    return `${startLabel}–${endLabel} your time`;
  } catch {
    return null;
  }
}

function Avatar({
  name,
  avatarUrl,
  online,
  sizeClassName = 'h-16 w-16',
  ringClassName = 'border-white',
  fallbackClassName = 'bg-neutral-200 text-neutral-700',
}: {
  name: string;
  avatarUrl: string | null | undefined;
  online: boolean;
  sizeClassName?: string;
  ringClassName?: string;
  fallbackClassName?: string;
}) {
  const [imgError, setImgError] = useState(false);

  useEffect(() => {
    setImgError(false);
  }, [avatarUrl]);

  const showImage = !!avatarUrl && !imgError;

  return (
    <div className="relative shrink-0">
      <div className={`${sizeClassName} overflow-hidden rounded-2xl`}>
        {showImage ? (
          <img
            src={avatarUrl!}
            alt={name}
            className="h-full w-full object-cover"
            onError={() => setImgError(true)}
          />
        ) : (
          <div
            className={`flex h-full w-full items-center justify-center rounded-2xl text-lg font-semibold ${fallbackClassName}`}
          >
            {name.slice(0, 1).toUpperCase()}
          </div>
        )}
      </div>

      <span
        className={`absolute bottom-0 right-0 h-3.5 w-3.5 rounded-full border-2 ${ringClassName} ${
          online ? 'bg-green-500' : 'bg-neutral-300'
        }`}
      />
    </div>
  );
}

function compactIdentity(age?: number | null, gender?: string | null) {
  const parts: string[] = [];
  if (typeof age === 'number' && Number.isFinite(age)) parts.push(String(age));
  if (gender?.trim()) parts.push(gender.trim());
  return parts.join(' • ');
}

function buildSeekingLine(interestedIn?: string[] | null) {
  if (!interestedIn || interestedIn.length === 0) return '';
  return interestedIn.join(', ');
}

function buildThreeWords(value?: string | null) {
  const raw = value?.trim() || '';
  if (!raw) return '';
  return raw.length > 42 ? `${raw.slice(0, 39)}...` : raw;
}

function buildStandoutLine({
  peopleNotice,
  shortBio,
  talkTopics,
}: {
  peopleNotice?: string | null;
  shortBio?: string | null;
  talkTopics?: string | null;
}) {
  const raw = peopleNotice?.trim() || shortBio?.trim() || talkTopics?.trim() || '';
  if (!raw) return '';
  return raw.length > 95 ? `${raw.slice(0, 92)}...` : raw;
}

function TinyPill({
  children,
}: {
  children: React.ReactNode;
}) {
  return (
    <span className="inline-flex rounded-full bg-neutral-100 px-2.5 py-1 text-[11px] font-semibold text-neutral-700">
      {children}
    </span>
  );
}

function buildPreviewProfile({
  id,
  title,
  avatarUrl,
  mode,
  shortBio,
  bestAt,
  lookingFor,
  tags,
  role,
  hostMode,
  locationText,
  timezone,
  normallyOnlineStart,
  normallyOnlineEnd,
  headline,
  age,
  gender,
  interestedIn,
  relationshipGoal,
  threeWords,
  peopleNotice,
  talkTopics,
}: {
  id: string;
  title: string;
  avatarUrl: string | null | undefined;
  mode: ChatMode | null;
  shortBio: string | null;
  bestAt: string | null;
  lookingFor: string | null;
  tags: string[] | null;
  role: 'host' | 'user';
  hostMode: string | null;
  locationText?: string | null;
  timezone?: string | null;
  normallyOnlineStart?: string | null;
  normallyOnlineEnd?: string | null;
  viewerTimezone?: string | null;
  headline?: string | null;
  age?: number | null;
  gender?: string | null;
  interestedIn?: string[] | null;
  relationshipGoal?: string | null;
  threeWords?: string | null;
  peopleNotice?: string | null;
  talkTopics?: string | null;
}): ProfilePreviewData {
  return {
    id,
    username: title,
    avatarUrl: avatarUrl ?? null,
    chat_mode: mode ?? null,
    role,
    host_mode: hostMode ?? null,
    is_system_host: false,
    headline: headline ?? null,
    short_bio: shortBio ?? null,
    talk_topics: talkTopics ?? null,
    best_at: bestAt ?? null,
    looking_for: lookingFor ?? null,
    profile_tags: tags ?? [],
    location_text: locationText ?? null,
    timezone: timezone ?? null,
    normally_online_start: normallyOnlineStart ?? null,
    normally_online_end: normallyOnlineEnd ?? null,
    age: age ?? null,
    gender: gender ?? null,
    interested_in: interestedIn ?? [],
    relationship_goal: relationshipGoal ?? null,
    three_words: threeWords ?? null,
    people_notice: peopleNotice ?? null,
  };
}

function buildInboxPreviewProfile(other: ProfileMini): ProfilePreviewData {
  return {
    id: other.id,
    username: other.username,
    avatarUrl: other.avatar_url ?? null,
    chat_mode: other.chat_mode ?? null,
    role: other.role ?? null,
    host_mode: other.host_mode ?? null,
    is_system_host: other.is_system_host ?? null,
    headline: other.headline ?? null,
    short_bio: other.short_bio ?? null,
    about_long: other.about_long ?? null,
    talk_topics: other.talk_topics ?? null,
    style_vibe: other.style_vibe ?? null,
    best_at: other.best_at ?? null,
    looking_for: other.looking_for ?? null,
    profile_tags: other.profile_tags ?? [],
    location_text: other.location_text ?? null,
    timezone: other.timezone ?? null,
    normally_online_start: other.normally_online_start ?? null,
    normally_online_end: other.normally_online_end ?? null,
    age: other.age ?? null,
    gender: other.gender ?? null,
    interested_in: other.interested_in ?? [],
    relationship_goal: other.relationship_goal ?? null,
    has_kids: other.has_kids ?? null,
    wants_kids: other.wants_kids ?? null,
    drink: other.drink ?? null,
    smoke: other.smoke ?? null,
    exercise: other.exercise ?? null,
    pets: other.pets ?? null,
    morning_or_night: other.morning_or_night ?? null,
    long_distance_open: other.long_distance_open ?? null,
    three_words: other.three_words ?? null,
    people_notice: other.people_notice ?? null,
    proud_of: other.proud_of ?? null,
    biggest_strength: other.biggest_strength ?? null,
    what_matters: other.what_matters ?? null,
    non_negotiable: other.non_negotiable ?? null,
    healthy_relationship: other.healthy_relationship ?? null,
    hidden_talent: other.hidden_talent ?? null,
    controversial_opinion: other.controversial_opinion ?? null,
    simple_pleasures: other.simple_pleasures ?? null,
    two_truths_lie: other.two_truths_lie ?? null,
  };
}

function ProfileCard({
  id,
  title,
  avatarUrl,
  online,
  mode,
  shortBio,
  bestAt,
  lookingFor,
  tags,
  role,
  hostMode,
  locationText,
  timezone,
  normallyOnlineStart,
  normallyOnlineEnd,
  viewerTimezone,
  headline,
  age,
  gender,
  interestedIn,
  relationshipGoal,
  threeWords,
  peopleNotice,
  talkTopics,
  onPreview,
  onOpenChat,
}: {
  id: string;
  title: string;
  avatarUrl: string | null | undefined;
  online: boolean;
  mode: ChatMode | null;
  shortBio: string | null;
  bestAt: string | null;
  lookingFor: string | null;
  tags: string[] | null;
  role: 'host' | 'user';
  hostMode: string | null;
  locationText?: string | null;
  timezone?: string | null;
  normallyOnlineStart?: string | null;
  normallyOnlineEnd?: string | null;
  viewerTimezone?: string | null;
  headline?: string | null;
  age?: number | null;
  gender?: string | null;
  interestedIn?: string[] | null;
  relationshipGoal?: string | null;
  threeWords?: string | null;
  peopleNotice?: string | null;
  talkTopics?: string | null;
  onPreview: (profile: ProfilePreviewData) => void;
  onOpenChat: (profileId: string) => void | Promise<void>;
}) {
  const modeLabel = getModeLabel(mode);
  const previewProfile = buildPreviewProfile({
    id,
    title,
    avatarUrl,
    mode,
    shortBio,
    bestAt,
    lookingFor,
    tags,
    role,
    hostMode,
    locationText,
    timezone,
    normallyOnlineStart,
    normallyOnlineEnd,
    headline,
    age,
    gender,
    interestedIn,
    relationshipGoal,
    threeWords,
    peopleNotice,
    talkTopics,
  });

  const safeTags = normalizeTags(tags);
  const safeBestAt = bestAt?.trim() || '';
  const safeLookingFor = lookingFor?.trim() || '';
  const identityLine = compactIdentity(age, gender);
  const seekingLine = buildSeekingLine(interestedIn);
  const wordsLine = buildThreeWords(threeWords);
  const standoutLine = buildStandoutLine({
    peopleNotice,
    shortBio,
    talkTopics,
  });

  const onlineWindowLabel = formatOnlineWindowForViewer(
    normallyOnlineStart ?? null,
    normallyOnlineEnd ?? null,
    timezone ?? null,
    viewerTimezone ?? null
  );

  return (
    <div className="w-full rounded-[22px] border border-fuchsia-100/80 bg-white/92 p-3 shadow-[0_14px_34px_rgba(83,34,115,0.05)] transition hover:border-fuchsia-200 hover:shadow-[0_14px_30px_rgba(83,34,115,0.08)]">
      <div className="flex items-start gap-4">
        <button type="button" onClick={() => onPreview(previewProfile)} className="rounded-2xl">
          <Avatar
            name={title}
            avatarUrl={avatarUrl}
            online={online}
            sizeClassName="h-20 w-20"
            ringClassName="border-white"
          />
        </button>

        <div className="min-w-0 flex-1">
          <div className="flex items-start justify-between gap-3">
            <div className="min-w-0">
              <button
                type="button"
                onClick={() => onPreview(previewProfile)}
                className="truncate text-left text-[16px] font-black tracking-tight text-neutral-950 transition hover:text-fuchsia-600"
              >
                {title}
              </button>

              <div className="mt-1 text-sm text-neutral-500">
                {online ? 'Online now' : 'Tap to chat'}
              </div>

              {locationText?.trim() && (
                <div className="mt-1 text-sm text-neutral-500">{locationText.trim()}</div>
              )}

              {onlineWindowLabel && (
                <div className="mt-1 text-xs font-medium text-neutral-500">
                  Normally online: {onlineWindowLabel}
                </div>
              )}
            </div>

            {modeLabel && (
              <span
                className={`shrink-0 rounded-full px-3 py-1 text-[11px] font-bold ${getModeClasses(
                  mode
                )}`}
              >
                {modeLabel}
              </span>
            )}
          </div>

          {(identityLine || seekingLine) && (
            <div className="mt-2 flex flex-wrap items-center gap-2">
              {identityLine ? (
                <div className="text-sm font-medium text-neutral-700">{identityLine}</div>
              ) : null}
              {seekingLine ? <TinyPill>Seeking: {seekingLine}</TinyPill> : null}
            </div>
          )}

          {wordsLine && (
            <div className="mt-1 text-sm font-semibold italic text-neutral-900">{wordsLine}</div>
          )}

          <div className="mt-2 max-w-[640px]">
            {standoutLine ? (
              <p className="text-sm leading-6 text-neutral-700">{standoutLine}</p>
            ) : (
              <p className="text-sm italic leading-6 text-neutral-400">No intro yet</p>
            )}
          </div>

          {safeTags.length > 0 && (
            <div className="mt-2 flex flex-wrap gap-2">
              {safeTags.map((tag) => (
                <span
                  key={tag}
                  className="rounded-full bg-neutral-100 px-3 py-1 text-[11px] font-semibold text-neutral-700"
                >
                  {tag}
                </span>
              ))}
            </div>
          )}

          {(safeBestAt || safeLookingFor || relationshipGoal?.trim()) && (
            <div className="mt-3 flex flex-wrap items-center gap-2">
              {safeBestAt ? <TinyPill>Best at: {safeBestAt}</TinyPill> : null}
              {safeLookingFor ? <TinyPill>Looking for: {safeLookingFor}</TinyPill> : null}
              {relationshipGoal?.trim() ? <TinyPill>Goal: {relationshipGoal.trim()}</TinyPill> : null}
            </div>
          )}

          <div className="mt-3">
            <button
              type="button"
              onClick={() => void onOpenChat(id)}
              className="rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-800 shadow-sm transition hover:bg-fuchsia-50"
            >
              Open chat
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}

export default function Sidebar({
  userId,
  activeConversationId,
  hosts,
  hostsLoading,
  hostsError,
  users,
  usersLoading,
  usersError,
  blocksLoading,
  isApprovedHostMe,
  inboxConversations,
  hiddenConversations = [],
  labels,
  lastByConvo,
  unreadByConvo,
  onlineProfileIds = new Set(),
  isDesktop,
  showHostsSection,
  showUsersSection,
  viewerTimezone = null,
  onRefreshHosts,
  onRefreshUsers,
  onRefreshInbox,
  onOpenProfile,
  onOpenProfilePreview,
  onSelectConversation,
  onHideConversation,
  onRestoreConversation,
}: SidebarProps) {
  const [showHidden, setShowHidden] = useState(false);

  useEffect(() => {
    if (hiddenConversations.length === 0 && showHidden) {
      setShowHidden(false);
    }
  }, [hiddenConversations.length, showHidden]);

  const isOnline = (profileId: string | null | undefined) => {
    if (!profileId) return false;
    return onlineProfileIds.has(profileId);
  };

  const isConnectMode = useMemo(() => {
    return (showHostsSection || showUsersSection) && inboxConversations.length === 0;
  }, [showHostsSection, showUsersSection, inboxConversations.length]);

  return (
    <div className="flex h-full min-h-0 flex-col bg-[linear-gradient(180deg,rgba(255,255,255,0.82)_0%,rgba(252,249,255,0.96)_100%)]">
      <div className="min-h-0 flex-1 overflow-y-auto">
        {showHostsSection && (
          <div className="border-b border-fuchsia-100/80 bg-white/50 px-3 py-3 backdrop-blur">
            <div className="mb-3 flex items-center justify-between gap-3">
              <div className="text-sm font-black tracking-tight text-neutral-950">Host Directory</div>
              <button
                type="button"
                onClick={() => void onRefreshHosts()}
                className="inline-flex items-center justify-center rounded-xl border border-fuchsia-100 bg-white px-3 py-2 text-xs font-semibold text-neutral-800 shadow-sm transition hover:bg-fuchsia-50"
              >
                Refresh
              </button>
            </div>

            {(hostsLoading || blocksLoading) && (
              <div className="rounded-2xl border border-fuchsia-100 bg-white px-3 py-3 text-sm text-neutral-500 shadow-sm">
                Loading…
              </div>
            )}

            {hostsError && (
              <div className="rounded-2xl border border-red-200 bg-red-50 px-3 py-3 text-sm text-red-700 shadow-sm">
                {hostsError}
              </div>
            )}

            {!hostsLoading && !hostsError && hosts.length === 0 && (
              <div className="rounded-2xl border border-dashed border-neutral-200 bg-white px-3 py-3 text-sm text-neutral-500 shadow-sm">
                No approved hosts yet.
              </div>
            )}

            <div className="space-y-3">
              {hosts.map((h) => (
                <ProfileCard
                  key={h.id}
                  id={h.id}
                  title={h.username?.trim() ? h.username : 'Host'}
                  avatarUrl={h.avatar_url}
                  online={isOnline(h.id)}
                  mode={h.chat_mode}
                  shortBio={h.short_bio}
                  bestAt={h.best_at}
                  lookingFor={h.looking_for}
                  tags={h.profile_tags}
                  role="host"
                  hostMode={h.host_mode}
                  locationText={h.location_text ?? null}
                  timezone={h.timezone ?? null}
                  normallyOnlineStart={h.normally_online_start ?? null}
                  normallyOnlineEnd={h.normally_online_end ?? null}
                  viewerTimezone={viewerTimezone}
                  headline={h.headline ?? null}
                  age={h.age ?? null}
                  gender={h.gender ?? null}
                  interestedIn={h.interested_in ?? []}
                  relationshipGoal={h.relationship_goal ?? null}
                  threeWords={h.three_words ?? null}
                  peopleNotice={h.people_notice ?? null}
                  talkTopics={h.talk_topics ?? null}
                  onPreview={onOpenProfilePreview}
                  onOpenChat={onOpenProfile}
                />
              ))}
            </div>
          </div>
        )}

        {showUsersSection && (
          <div className="border-b border-fuchsia-100/80 bg-white/45 px-3 py-3 backdrop-blur">
            <div className="mb-3 flex items-center justify-between gap-3">
              <div className="text-sm font-black tracking-tight text-neutral-950">
                Discoverable Users
              </div>
              <button
                type="button"
                onClick={() => void onRefreshUsers()}
                className="inline-flex items-center justify-center rounded-xl border border-fuchsia-100 bg-white px-3 py-2 text-xs font-semibold text-neutral-800 shadow-sm transition hover:bg-fuchsia-50"
              >
                Refresh
              </button>
            </div>

            {(usersLoading || blocksLoading) && (
              <div className="rounded-2xl border border-fuchsia-100 bg-white px-3 py-3 text-sm text-neutral-500 shadow-sm">
                Loading…
              </div>
            )}

            {usersError && (
              <div className="rounded-2xl border border-red-200 bg-red-50 px-3 py-3 text-sm text-red-700 shadow-sm">
                {usersError}
              </div>
            )}

            {!usersLoading && !usersError && users.length === 0 && (
              <div className="rounded-2xl border border-dashed border-neutral-200 bg-white px-3 py-3 text-sm text-neutral-500 shadow-sm">
                No discoverable users right now.
              </div>
            )}

            <div className="space-y-3">
              {users.map((u) => (
                <ProfileCard
                  key={u.id}
                  id={u.id}
                  title={u.username?.trim() ? u.username : 'User'}
                  avatarUrl={u.avatar_url}
                  online={isOnline(u.id)}
                  mode={u.chat_mode}
                  shortBio={u.short_bio}
                  bestAt={u.best_at}
                  lookingFor={u.looking_for}
                  tags={u.profile_tags}
                  role="user"
                  hostMode={null}
                  locationText={u.location_text ?? null}
                  timezone={u.timezone ?? null}
                  normallyOnlineStart={u.normally_online_start ?? null}
                  normallyOnlineEnd={u.normally_online_end ?? null}
                  viewerTimezone={viewerTimezone}
                  headline={u.headline ?? null}
                  age={u.age ?? null}
                  gender={u.gender ?? null}
                  interestedIn={u.interested_in ?? []}
                  relationshipGoal={u.relationship_goal ?? null}
                  threeWords={u.three_words ?? null}
                  peopleNotice={u.people_notice ?? null}
                  talkTopics={u.talk_topics ?? null}
                  onPreview={onOpenProfilePreview}
                  onOpenChat={onOpenProfile}
                />
              ))}
            </div>
          </div>
        )}

        {!isConnectMode && (
          <div className="border-b border-fuchsia-100/80 px-3 py-3">
            <div className="mb-3 flex items-center justify-between gap-3">
              <div className="text-sm font-black tracking-tight text-neutral-950">Inbox</div>
              {isDesktop && (
                <button
                  type="button"
                  onClick={() => void onRefreshInbox()}
                  className="inline-flex items-center justify-center rounded-xl border border-fuchsia-100 bg-white px-3 py-2 text-xs font-semibold text-neutral-800 shadow-sm transition hover:bg-fuchsia-50"
                >
                  Refresh
                </button>
              )}
            </div>

            {inboxConversations.length === 0 ? (
              <div className="rounded-2xl border border-dashed border-neutral-200 bg-white px-3 py-4 text-sm text-neutral-500 shadow-sm">
                No conversations yet.
              </div>
            ) : (
              <div className="space-y-2">
                {inboxConversations.map((c) => {
                  const other = labels[c.id];
                  const last = lastByConvo[c.id];
                  const unread = unreadByConvo[c.id] === true;
                  const online = isOnline(other?.id);

                  const name = getDisplayName(other);
                  const mode = other?.host_mode?.trim() ? other.host_mode : '';
                  const prefix =
                    last && userId && last.sender_id === userId ? 'You: ' : last ? `${name}: ` : '';
                  const preview = last
                    ? `${prefix}${snippet(last.content)}`
                    : mode
                      ? mode
                      : `${c.id.slice(0, 8)}…`;
                  const time = last ? formatSidebarTime(last.created_at) : '';

                  const previewProfile = other ? buildInboxPreviewProfile(other) : null;
                  const isActive = c.id === activeConversationId;

                  return (
                    <div
                      key={c.id}
                      className={[
                        'overflow-hidden rounded-2xl border transition shadow-sm',
                        isActive
                          ? 'border-violet-200 bg-gradient-to-r from-violet-50 to-fuchsia-50'
                          : unread
                            ? 'border-sky-200 bg-sky-50/90'
                            : 'border-fuchsia-100/80 bg-white/92',
                      ].join(' ')}
                    >
                      <div
                        role="button"
                        tabIndex={0}
                        onClick={() => onSelectConversation(c.id)}
                        onKeyDown={(e) => {
                          if (e.key === 'Enter' || e.key === ' ') {
                            e.preventDefault();
                            onSelectConversation(c.id);
                          }
                        }}
                        className={[
                          'group w-full min-h-[88px] cursor-pointer px-3 py-3 text-left transition active:scale-[0.99]',
                          isActive ? 'hover:bg-white/40' : unread ? 'hover:bg-sky-100' : 'hover:bg-fuchsia-50/60',
                        ].join(' ')}
                      >
                        <div className="flex items-start gap-3">
                          <button
                            type="button"
                            onClick={(e) => {
                              e.stopPropagation();
                              if (previewProfile) onOpenProfilePreview(previewProfile);
                            }}
                            className="rounded-2xl"
                            disabled={!previewProfile}
                          >
                            <Avatar
                              name={name}
                              avatarUrl={other?.avatar_url}
                              online={online}
                              sizeClassName="h-16 w-16"
                              ringClassName="border-white"
                              fallbackClassName={
                                isActive
                                  ? 'bg-violet-100 text-violet-700'
                                  : unread
                                    ? 'bg-sky-100 text-sky-800'
                                    : 'bg-neutral-200 text-neutral-700'
                              }
                            />
                          </button>

                          <div className="min-w-0 flex-1">
                            <div className="flex items-center justify-between gap-2">
                              <div className="flex min-w-0 items-center gap-2">
                                {unread && !isActive && (
                                  <span className="h-2.5 w-2.5 shrink-0 rounded-full bg-red-500" />
                                )}

                                <button
                                  type="button"
                                  onClick={(e) => {
                                    e.stopPropagation();
                                    if (previewProfile) onOpenProfilePreview(previewProfile);
                                  }}
                                  disabled={!previewProfile}
                                  className={[
                                    'truncate text-left text-sm disabled:cursor-default',
                                    unread && !isActive
                                      ? 'font-bold text-neutral-950'
                                      : 'font-semibold text-neutral-900',
                                  ].join(' ')}
                                >
                                  {name}
                                </button>
                              </div>

                              {time && (
                                <span
                                  className={[
                                    'shrink-0 text-[11px]',
                                    unread && !isActive ? 'font-semibold text-sky-700' : 'text-neutral-500',
                                  ].join(' ')}
                                >
                                  {time}
                                </span>
                              )}
                            </div>

                            <div className="mt-1 flex items-center gap-2">
                              <p
                                className={[
                                  'truncate text-xs',
                                  unread && !isActive
                                    ? 'font-semibold text-neutral-800'
                                    : 'text-neutral-500',
                                ].join(' ')}
                              >
                                {preview}
                              </p>

                              {unread && !isActive && (
                                <span className="shrink-0 rounded-full bg-red-500 px-2 py-0.5 text-[10px] font-semibold text-white">
                                  NEW
                                </span>
                              )}
                            </div>
                          </div>
                        </div>
                      </div>

                      <div className="flex justify-end px-3 pb-3">
                        <button
                          type="button"
                          onClick={() => void onHideConversation(c.id)}
                          className={[
                            'rounded-xl border px-3 py-2 text-xs font-semibold shadow-sm transition',
                            unread
                              ? 'border-sky-200 bg-white text-sky-900 hover:bg-sky-50'
                              : 'border-neutral-300 bg-white text-neutral-800 hover:bg-fuchsia-50',
                          ].join(' ')}
                        >
                          Hide
                        </button>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        )}

        {!isConnectMode && (
          <div className="px-3 py-3">
            <button
              type="button"
              onClick={() => setShowHidden((prev) => !prev)}
              className="flex w-full items-center justify-between rounded-xl px-3 py-2 text-left text-sm font-semibold text-neutral-900 transition hover:bg-fuchsia-50/70"
            >
              <span>
                Hidden conversations
                {hiddenConversations.length > 0 ? ` (${hiddenConversations.length})` : ''}
              </span>
              <span className="text-xs text-neutral-500">
                {hiddenConversations.length === 0 ? 'Empty' : showHidden ? 'Hide' : 'Show'}
              </span>
            </button>

            {showHidden && (
              <div className="mt-2 space-y-2">
                {hiddenConversations.length === 0 ? (
                  <div className="rounded-2xl border border-dashed border-neutral-200 bg-white px-3 py-4 text-sm text-neutral-500 shadow-sm">
                    No hidden conversations.
                  </div>
                ) : (
                  hiddenConversations.map((c) => {
                    const other = labels[c.id];
                    const last = lastByConvo[c.id];
                    const online = isOnline(other?.id);

                    const name = getDisplayName(other);
                    const preview = last ? snippet(last.content) : 'Hidden conversation';
                    const time = last ? formatSidebarTime(last.created_at) : '';

                    const previewProfile = other ? buildInboxPreviewProfile(other) : null;

                    return (
                      <div
                        key={c.id}
                        className="rounded-2xl border border-fuchsia-100/80 bg-white/88 px-3 py-3 shadow-sm"
                      >
                        <div className="flex items-start gap-3">
                          <button
                            type="button"
                            onClick={() => {
                              if (previewProfile) onOpenProfilePreview(previewProfile);
                            }}
                            className="rounded-2xl"
                            disabled={!previewProfile}
                          >
                            <Avatar
                              name={name}
                              avatarUrl={other?.avatar_url}
                              online={online}
                              sizeClassName="h-16 w-16"
                              ringClassName="border-white"
                            />
                          </button>

                          <div className="min-w-0 flex-1">
                            <div className="flex items-center justify-between gap-2">
                              <button
                                type="button"
                                onClick={() => {
                                  if (previewProfile) onOpenProfilePreview(previewProfile);
                                }}
                                disabled={!previewProfile}
                                className="truncate text-left text-sm font-semibold text-neutral-900 hover:text-fuchsia-600 disabled:cursor-default"
                              >
                                {name}
                              </button>

                              {time && (
                                <span className="shrink-0 text-[11px] text-neutral-500">{time}</span>
                              )}
                            </div>

                            <p className="mt-1 truncate text-xs text-neutral-500">{preview}</p>

                            <div className="mt-3 flex justify-end">
                              <button
                                type="button"
                                onClick={() => void onRestoreConversation(c.id)}
                                className="rounded-xl bg-neutral-900 px-3 py-2 text-xs font-semibold text-white shadow-sm transition hover:opacity-90"
                              >
                                Restore
                              </button>
                            </div>
                          </div>
                        </div>
                      </div>
                    );
                  })
                )}
              </div>
            )}

            {!showHidden && hiddenConversations.length > 0 && (
              <div className="px-3 pt-2 text-xs leading-5 text-neutral-500">
                Out of sight for a cleaner inbox. Tap Show when you want to manage them.
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
}